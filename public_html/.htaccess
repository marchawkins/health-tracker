Options -Indexes
RewriteEngine On

# Serve real files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route /api/* to the API router
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# SPA fallback — everything else goes to index.html
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # sw.js must never be cached — if iOS caches the old SW file it will
    # never notice that the SW has been updated after a deploy.
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>

    # index.html: no-cache so the browser always checks for a fresh copy
    # (which in turn triggers the SW update check on every visit).
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
